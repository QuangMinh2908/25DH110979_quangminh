@model PagedList.IPagedList<_25DH110979_quangminh.Models.Customer>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="admin-header-title mb-0"><i class="fa-solid fa-users text-primary me-2"></i>Quản Lý Khách Hàng</h3>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-5">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm kiếm theo tên, SĐT, Email, username..." />
            </div>
            <div class="col-md-3">
                <select name="sortOrder" class="form-select form-select-sm">
                    <option value="" @(string.IsNullOrEmpty(ViewBag.CurrentSort) ? "selected" : "")>Mới nhất</option>
                    <option value="name_asc" @(ViewBag.CurrentSort == "name_asc" ? "selected" : "")>Tên (A - Z)</option>
                    <option value="name_desc" @(ViewBag.CurrentSort == "name_desc" ? "selected" : "")>Tên (Z - A)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-magnifying-glass me-1"></i> Tìm</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Mã KH</th>
                        <th>Họ và tên</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Tài khoản</th>
                        <th class="text-center">Số đơn</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-muted">#@item.CustomerID</td>
                                <td class="fw-semibold text-primary">@item.CustomerName</td>
                                <td>@item.CustomerPhone</td>
                                <td>@(string.IsNullOrEmpty(item.CustomerEmail) ? "---" : item.CustomerEmail)</td>
                                <td><code>@item.Username</code></td>
                                <td class="text-center">
                                    <span class="badge bg-secondary fs-6">@(item.Order != null ? item.Order.Count : 0)</span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.CustomerID })" class="btn btn-sm btn-outline-info">
                                        <i class="fa-regular fa-eye me-1"></i> Chi tiết & Đơn hàng
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy khách hàng nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model != null && Model.PageCount > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Trang @Model.PageNumber / @Model.PageCount (Tổng cộng @Model.TotalItemCount khách)</span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm, sortOrder = ViewBag.CurrentSort }))
        </div>
    }
</div>
