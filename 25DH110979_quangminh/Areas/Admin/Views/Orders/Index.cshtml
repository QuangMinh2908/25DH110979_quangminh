@model PagedList.IPagedList<_25DH110979_quangminh.Models.Order>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="admin-header-title mb-0"><i class="fa-solid fa-cart-shopping text-primary me-2"></i>Quản Lý Đơn Hàng</h3>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Orders", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-5">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm theo mã đơn (#1), tên khách hàng, SĐT..." />
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select form-select-sm">
                    <option value="" @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "selected" : "")>-- Tất cả trạng thái --</option>
                    <option value="Chờ xử lý" @(ViewBag.CurrentStatus == "Chờ xử lý" ? "selected" : "")>Chờ xử lý</option>
                    <option value="Chờ thanh toán" @(ViewBag.CurrentStatus == "Chờ thanh toán" ? "selected" : "")>Chờ thanh toán</option>
                    <option value="Đang xử lý" @(ViewBag.CurrentStatus == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                    <option value="Đang vận chuyển" @(ViewBag.CurrentStatus == "Đang vận chuyển" ? "selected" : "")>Đang vận chuyển</option>
                    <option value="Đã giao" @(ViewBag.CurrentStatus == "Đã giao" ? "selected" : "")>Đã giao</option>
                    <option value="Đã hủy" @(ViewBag.CurrentStatus == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-magnifying-glass me-1"></i> Lọc đơn</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Phương thức TT</th>
                        <th>Vận chuyển</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">#@item.OrderID</td>
                                <td>
                                    <strong>@(item.Customer != null ? item.Customer.CustomerName : "N/A")</strong>
                                    <div class="small text-muted">@(item.Customer != null ? item.Customer.CustomerPhone : "")</div>
                                </td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold text-danger">@item.TotalAmount.ToString("N0") đ</td>
                                <td><span class="badge bg-light text-dark border">@(string.IsNullOrEmpty(item.PaymentMethod) ? "Tiền mặt (COD)" : item.PaymentMethod)</span></td>
                                <td class="small">@(string.IsNullOrEmpty(item.DeliveryMethod) ? "Giao thường" : item.DeliveryMethod)</td>
                                <td>
                                    @{
                                        string bgClass = "bg-secondary";
                                        string st = item.PaymentStatus ?? "Chờ xử lý";
                                        if (st.Contains("Đã giao")) { bgClass = "bg-success"; }
                                        else if (st.Contains("vận chuyển")) { bgClass = "bg-primary"; }
                                        else if (st.Contains("xử lý")) { bgClass = "bg-info text-dark"; }
                                        else if (st.Contains("Chờ")) { bgClass = "bg-warning text-dark"; }
                                        else if (st.Contains("hủy")) { bgClass = "bg-danger"; }
                                    }
                                    <span class="badge @bgClass">@st</span>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Details", new { id = item.OrderID })" class="btn btn-sm btn-outline-info">
                                        <i class="fa-regular fa-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model != null && Model.PageCount > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Trang @Model.PageNumber / @Model.PageCount (Tổng cộng @Model.TotalItemCount đơn)</span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm, status = ViewBag.CurrentStatus }))
        </div>
    }
</div>
