@model _25DH110979_quangminh.Models.Order
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statusList = new[] { "Chờ thanh toán", "Chờ xử lý", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
}

<h3 class="fw-bold mb-3">CHI TIẾT ĐƠN HÀNG #@Model.OrderID</h3>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-4">
            <!-- Cột trái: Thông tin đơn hàng -->
            <div class="col-md-5 border-end">
                <h6 class="fw-bold text-uppercase text-muted mb-3">THÔNG TIN ĐƠN HÀNG</h6>
                <table class="table table-borderless table-sm">
                    <tr>
                        <th class="text-end w-50">Ngày đặt hàng:</th>
                        <td>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th class="text-end">Tên khách hàng:</th>
                        <td class="fw-bold">@(Model.Customer != null ? Model.Customer.CustomerName : "Khách #" + Model.CustomerID)</td>
                    </tr>
                    <tr>
                        <th class="text-end">Tổng giá trị:</th>
                        <td class="text-danger fw-bold fs-5">@Model.TotalAmount.ToString("N0") đ</td>
                    </tr>
                    <tr>
                        <th class="text-end">Phương thức thanh toán:</th>
                        <td>@(Model.PaymentMethod ?? "Tiền mặt khi nhận hàng")</td>
                    </tr>
                    <tr>
                        <th class="text-end">Trạng thái thanh toán:</th>
                        <td><span class="badge bg-warning text-dark fs-6">@(Model.PaymentStatus ?? "Chờ thanh toán")</span></td>
                    </tr>
                    <tr>
                        <th class="text-end">Phương thức giao hàng:</th>
                        <td>@(Model.DeliveryMethod ?? "Giao hàng thường")</td>
                    </tr>
                    <tr>
                        <th class="text-end">Địa chỉ giao hàng:</th>
                        <td>@Model.ShippingAddress</td>
                    </tr>
                </table>
            </div>

            <!-- Cột phải: Danh sách sản phẩm trong đơn -->
            <div class="col-md-7">
                <h6 class="fw-bold text-uppercase text-muted mb-3">SẢN PHẨM ĐÃ ĐẶT</h6>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Đơn giá</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetail != null)
                            {
                                foreach (var d in Model.OrderDetail)
                                {
                                    string imgUrl = (d.Product != null && !string.IsNullOrEmpty(d.Product.ProductImage))
    ? (d.Product.ProductImage.StartsWith("~") || d.Product.ProductImage.StartsWith("/")
        ? Url.Content(d.Product.ProductImage)
        : Url.Content("~/Content/images/" + d.Product.ProductImage))
    : Url.Content("~/Content/images/default.png");
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@imgUrl" alt="SP" class="rounded border me-2" style="width:55px; height:55px; object-fit:cover;" />
                                                <span class="fw-semibold">@(d.Product != null ? d.Product.ProductName : "Sản phẩm #" + d.ProductID)</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@d.Quantity</td>
                                        <td class="text-end">@d.UnitPrice.ToString("N0") đ</td>
                                        <td class="text-end fw-bold text-danger">@((d.Quantity * d.UnitPrice).ToString("N0")) đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <hr />

        <!-- Cập nhật trạng thái & Quay lại danh sách -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            @using (Html.BeginForm("UpdateStatus", "Orders", new { area = "Admin" }, FormMethod.Post, new { @class = "d-flex align-items-center gap-2" }))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.OrderID" />
                <select name="status" class="form-select" style="width:220px;">
                    @foreach (var st in statusList)
                    {
                        <option value="@st" @(Model.PaymentStatus == st ? "selected" : "")>@st</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-sync-alt me-1"></i> Cập nhật trạng thái
                </button>
            }

            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>
</div>