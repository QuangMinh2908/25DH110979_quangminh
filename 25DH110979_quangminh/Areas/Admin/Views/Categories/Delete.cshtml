@model _25DH110979_quangminh.Models.Category
@{
    ViewBag.Title = "Xác nhận xóa danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-danger shadow-sm col-lg-8 mx-auto my-4">
    <div class="card-header bg-danger text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i>Xác Nhận Xóa Danh Mục</h5>
    </div>
    <div class="card-body p-4">
        <div class="alert alert-warning">
            <i class="fa-solid fa-circle-exclamation me-2"></i> Bạn có chắc chắn muốn xóa danh mục này? Hệ thống chỉ cho phép xóa nếu danh mục không chứa bất kỳ sản phẩm nào!
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-4 text-muted">Mã danh mục:</dt>
            <dd class="col-sm-8 fw-bold">#@Model.CategoryID</dd>

            <dt class="col-sm-4 text-muted">Tên danh mục:</dt>
            <dd class="col-sm-8 fw-bold text-danger">@Model.CategoryName</dd>

            <dt class="col-sm-4 text-muted">Số lượng sản phẩm liên quan:</dt>
            <dd class="col-sm-8"><span class="badge bg-secondary fs-6">@(Model.Product != null ? Model.Product.Count : 0)</span></dd>
        </dl>

        <hr />
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Hủy & Quay lại
                </a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="fa-solid fa-trash-can me-1"></i> Xác nhận xóa
                </button>
            </div>
        }
    </div>
</div>
