@model _25DH110979_quangminh.Models.Product
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card shadow-sm border-0 my-3">
    <div class="card-header bg-info text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="fa-solid fa-circle-info me-2"></i>Chi Tiết Sản Phẩm: @Model.ProductName</h5>
    </div>
    <div class="card-body p-4">
        @Html.Partial("PVProductInfo", Model)

        <hr class="my-4" />
        <div class="d-flex justify-content-between">
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
            </a>
            <a href="@Url.Action("Edit", new { id = Model.ProductID })" class="btn btn-warning px-4 fw-bold">
                <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
            </a>
        </div>
    </div>
</div>
