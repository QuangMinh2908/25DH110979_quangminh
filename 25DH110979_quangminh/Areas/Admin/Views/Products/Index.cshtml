@model _25DH110979_quangminh.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="admin-header-title mb-0"><i class="fa-solid fa-box-open text-primary me-2"></i>Quản Lý Sản Phẩm</h3>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> Thêm Sản Phẩm Mới
    </a>
</div>

<!-- Form Tìm Kiếm, Lọc & Sắp Xếp -->
<div class="card shadow-sm mb-4">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label small fw-bold">Từ khóa tìm kiếm:</label>
                @Html.TextBox("searchTerm", Model.SearchTerm, new { @class = "form-control form-control-sm", placeholder = "Tìm theo tên, mô tả..." })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Danh mục:</label>
                @Html.DropDownList("categoryId", Model.CategoryList, "-- Tất cả danh mục --", new { @class = "form-select form-select-sm" })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Giá tối thiểu (đ):</label>
                @Html.TextBox("minPrice", Model.MinPrice, new { @class = "form-control form-control-sm", type = "number", min = "0", placeholder = "Từ đ..." })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Giá tối đa (đ):</label>
                @Html.TextBox("maxPrice", Model.MaxPrice, new { @class = "form-control form-control-sm", type = "number", min = "0", placeholder = "Đến đ..." })
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">Sắp xếp:</label>
                <select name="sortOrder" class="form-select form-select-sm">
                    <option value="" @(string.IsNullOrEmpty(Model.SortOrder) ? "selected" : "")>Mới nhất</option>
                    <option value="name_asc" @(Model.SortOrder == "name_asc" ? "selected" : "")>Tên (A - Z)</option>
                    <option value="name_desc" @(Model.SortOrder == "name_desc" ? "selected" : "")>Tên (Z - A)</option>
                    <option value="price_asc" @(Model.SortOrder == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                    <option value="price_desc" @(Model.SortOrder == "price_desc" ? "selected" : "")>Giá giảm dần</option>
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm w-100" title="Tìm kiếm">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-rotate-left"></i>
                </a>
            </div>
        }
    </div>
</div>

<!-- Danh sách sản phẩm -->
<div class="card shadow-sm">
    <div class="card-body p-0">
        @Html.Partial("PVListProduct", Model.Products)
    </div>
    @if (Model.Products != null && Model.Products.PageCount > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <div class="text-muted small">
                Trang @(Model.Products.PageCount < Model.Products.PageNumber ? 0 : Model.Products.PageNumber) / @Model.Products.PageCount
                (Tổng cộng @Model.Products.TotalItemCount sản phẩm)
            </div>
            <div class="pagination-container">
                @Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, searchTerm = Model.SearchTerm, categoryId = Model.CategoryID, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, sortOrder = Model.SortOrder }))
            </div>
        </div>
    }
</div>
