@model PagedList.IPagedList<_25DH110979_quangminh.Models.User>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="admin-header-title mb-0"><i class="fa-solid fa-user-shield text-primary me-2"></i>Danh Sách Tài Khoản Quản Trị Viên</h3>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm">
        <i class="fa-solid fa-user-plus me-1"></i> Thêm Admin Mới
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body p-3">
        @using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-5">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control form-control-sm" placeholder="Tìm kiếm theo tên tài khoản Admin..." />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-magnifying-glass me-1"></i> Tìm</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm" title="Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="ps-3">Tên đăng nhập (Username)</th>
                        <th>Vai trò</th>
                        <th class="text-center" style="width: 25%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <i class="fa-solid fa-user-gear text-primary me-2"></i>@item.Username
                                </td>
                                <td>
                                    <span class="badge bg-danger fs-6">Quản Trị Viên (Admin)</span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Edit", new { id = item.Username })" class="btn btn-outline-warning" title="Chỉnh sửa">
                                            <i class="fa-regular fa-pen-to-square"></i> Sửa mật khẩu
                                        </a>
                                        @if (item.Username.ToLower() != "admin")
                                        {
                                            <a href="@Url.Action("Delete", new { id = item.Username })" class="btn btn-outline-danger" title="Xóa">
                                                <i class="fa-regular fa-trash-can"></i> Xóa
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Không tìm thấy tài khoản quản trị nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model != null && Model.PageCount > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Trang @Model.PageNumber / @Model.PageCount (Tổng cộng @Model.TotalItemCount Admin)</span>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, searchTerm = ViewBag.SearchTerm }))
        </div>
    }
</div>
