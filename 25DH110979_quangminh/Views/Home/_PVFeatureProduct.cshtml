@model IEnumerable<_25DH110979_quangminh.Models.Product>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative p-2">
                    <span class="badge bg-danger position-absolute top-0 start-0 m-2"><i class="fa-solid fa-fire me-1"></i>Hot</span>
                    <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-center p-2 d-block bg-white">
                        <img src="~/Content/images/@(string.IsNullOrEmpty(item.ProductImage) ? "default.png" : item.ProductImage)" 
                             style="height: 150px; width: 100%; object-fit: contain;" 
                             onerror="this.src='/Content/images/default.png'" alt="@item.ProductName" loading="lazy" />
                    </a>
                    <div class="card-body p-2 d-flex flex-column">
                        <span class="badge bg-light text-secondary border mb-1 align-self-start small">@(item.Category != null ? item.Category.CategoryName : "")</span>
                        <h6 class="card-title fw-bold small text-truncate" title="@item.ProductName">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="text-dark text-decoration-none">@item.ProductName</a>
                        </h6>
                        <div class="small text-muted mb-1">
                            <span>Tồn: <strong class="@(item.Quantity > 0 ? "text-success" : "text-danger")">@item.Quantity</strong></span> | 
                            <span>Đã bán: @item.SoldQuantity</span>
                        </div>
                        <div class="text-danger fw-bold fs-6 mb-2 mt-auto">
                            @item.ProductPrice.ToString("N0") đ
                        </div>
                        <div class="d-flex gap-1 mt-auto">
                            <a href="@Url.Action("ProductDetail", "Home", new { id = item.ProductID })" class="btn btn-outline-primary btn-sm flex-fill">
                                Chi tiết
                            </a>
                            @if (item.Quantity > 0)
                            {
                                <a href="@Url.Action("AddToCart", "Cart", new { productId = item.ProductID })" class="btn btn-warning btn-sm" title="Thêm vào giỏ">
                                    <i class="fa-solid fa-cart-plus"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
