@model _25DH110979_quangminh.Models.ViewModel.HomeProductVM
@{
    ViewBag.Title = "Trang chủ - MyStore Cửa Hàng Công Nghệ";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<!-- Banner Carousel -->
<div id="bannerCarousel" class="carousel slide mb-4 shadow-sm" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#bannerCarousel" data-bs-slide-to="1"></button>
    </div>
    <div class="carousel-inner" style="border-radius: 12px; overflow: hidden;">
        <div class="carousel-item active">
            <a href="@Url.Action("ProductList", "Home")">
                <img src="~/Content/images/banner-main.png" class="d-block w-100 img-fluid" alt="MyStore Technology Banner" />
            </a>
        </div>
        <div class="carousel-item">
            <div class="bg-danger text-white d-flex align-items-center justify-content-center p-5 text-center" style="min-height: 360px; background: linear-gradient(135deg, #dc3545, #fd7e14);">
                <div>
                    <h1 class="display-5 fw-bold mb-2"><i class="fa-solid fa-fire me-2"></i>Siêu Ưu Đãi Tháng Này</h1>
                    <p class="lead mb-3">Giảm giá lên đến 30% cho các sản phẩm bán chạy nhất!</p>
                    <a href="@Url.Action("ProductList", "Home")" class="btn btn-warning btn-lg fw-bold px-4 shadow">
                        <i class="fas fa-bolt me-1"></i> Mua ngay giá tốt
                    </a>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- Thanh tìm kiếm nhanh trên trang chủ -->
<div class="card shadow-sm mb-5 border-0">
    <div class="card-body p-3">
        @using (Html.BeginForm("ProductList", "Home", FormMethod.Get, new { @class = "row g-2 align-items-center" }))
        {
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fas fa-search text-muted"></i></span>
                    <input type="text" name="searchTerm" class="form-control" placeholder="Tìm theo tên sản phẩm, cấu hình, mô tả..." value="@Model.SearchTerm" />
                </div>
            </div>
            <div class="col-md-4">
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả danh mục sản phẩm --</option>
                    @if (Model.Categories != null)
                    {
                        foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryID" @(Model.CategoryID == cat.CategoryID ? "selected" : "")>@cat.CategoryName</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 fw-bold">
                    <i class="fas fa-search me-1"></i> Tìm kiếm
                </button>
            </div>
        }
    </div>
</div>

<!-- Sản phẩm nổi bật (Top 10 bán chạy) -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="fw-bold text-danger mb-0"><i class="fa-solid fa-fire me-2"></i>Top 10 Sản Phẩm Bán Chạy</h3>
        <a href="@Url.Action("ProductList", "Home", new { sortOrder = "price_desc" })" class="text-decoration-none small fw-semibold">
            Xem tất cả <i class="fas fa-chevron-right ms-1"></i>
        </a>
    </div>
    @Html.Partial("_PVFeatureProduct", Model.FeaturedProducts)
</section>

<!-- Sản phẩm mới nhất -->
<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h3 class="fw-bold text-primary mb-0"><i class="fa-solid fa-sparkles me-2"></i>Sản Phẩm Mới Nhất</h3>
        <a href="@Url.Action("ProductList", "Home")" class="text-decoration-none small fw-semibold">
            Xem tất cả <i class="fas fa-chevron-right ms-1"></i>
        </a>
    </div>
    @Html.Partial("_PVNewProduct", Model.NewProducts)
</section>