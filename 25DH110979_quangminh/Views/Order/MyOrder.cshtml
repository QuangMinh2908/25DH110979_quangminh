@model PagedList.IPagedList<_25DH110979_quangminh.Models.Order>
@using PagedList.Mvc
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    var statusList = new[] { "Chờ xử lý", "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="fas fa-history text-primary"></i> Lịch sử mua hàng</h3>
    <a href="@Url.Action("Index","Home")" class="btn btn-outline-primary btn-sm"><i class="fas fa-shopping-bag"></i> Tiếp tục mua sắm</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show">
        @TempData["Warning"]
    </div>
}

<!-- Tìm kiếm và Tabs trạng thái -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("MyOrder", "Order")" class="row g-2 mb-3">
            <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
            <div class="col-md-9">
                <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tìm theo mã đơn hàng hoặc tên sản phẩm..." />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Tìm kiếm</button>
            </div>
        </form>

        <!-- Status Tabs -->
        <ul class="nav nav-pills flex-column flex-sm-row">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "active" : "")" 
                   href="@Url.Action("MyOrder", "Order", new { searchTerm = ViewBag.SearchTerm })">Tất cả</a>
            </li>
            @foreach (var s in statusList)
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewBag.CurrentStatus == s ? "active" : "")" 
                       href="@Url.Action("MyOrder", "Order", new { status = s, searchTerm = ViewBag.SearchTerm })">@s</a>
                </li>
            }
        </ul>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info text-center py-4">
        <i class="fas fa-box-open fa-2x mb-2 text-muted"></i>
        <p class="mb-0">Bạn chưa có đơn hàng nào trong mục này.</p>
    </div>
}
else
{
    foreach (var order in Model)
    {
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div>
                    <span class="fw-bold text-primary">Đơn hàng #@order.OrderID</span>
                    <span class="text-muted ms-2 small"><i class="far fa-clock"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div>
                    @{
                        string badgeClass = "bg-secondary";
                        string st = order.PaymentStatus ?? "Chờ xử lý";
                        if (st.Contains("Đã giao")) { badgeClass = "bg-success"; }
                        else if (st.Contains("vận chuyển")) { badgeClass = "bg-primary"; }
                        else if (st.Contains("xử lý")) { badgeClass = "bg-info text-dark"; }
                        else if (st.Contains("Chờ")) { badgeClass = "bg-warning text-dark"; }
                        else if (st.Contains("hủy")) { badgeClass = "bg-danger"; }
                    }
                    <span class="badge @badgeClass fs-6">@st</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row align-items-center">
                    <div class="col-md-7">
                        @if (order.OrderDetail != null && order.OrderDetail.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var d in order.OrderDetail)
                                {
                                    <li class="mb-1">
                                        <i class="fas fa-check-circle text-muted me-1"></i>
                                        <strong>@(d.Product != null ? d.Product.ProductName : "Sản phẩm #" + d.ProductID)</strong>
                                        <span class="text-muted">x @d.Quantity</span>
                                        <span class="text-danger ms-2">(@d.UnitPrice.ToString("N0") đ)</span>
                                    </li>
                                }
                            </ul>
                        }
                        <div class="text-muted small mt-2">
                            <i class="fas fa-map-marker-alt"></i> @order.ShippingAddress
                        </div>
                    </div>
                    <div class="col-md-5 text-md-end mt-3 mt-md-0">
                        <div class="mb-2">
                            <span class="text-muted">Tổng tiền: </span>
                            <span class="fs-5 fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</span>
                        </div>
                        <div class="btn-group">
                            <a href="@Url.Action("OrderSuccess", "Order", new { orderId = order.OrderID })" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> Chi tiết
                            </a>
                            <a href="@Url.Action("ReOrder", "Order", new { id = order.OrderID })" class="btn btn-sm btn-outline-success">
                                <i class="fas fa-redo"></i> Mua lại
                            </a>
                            @if (order.PaymentStatus == "Chờ xử lý" || order.PaymentStatus == "Chờ thanh toán")
                            {
                                <a href="@Url.Action("CancelOrder", "Order", new { id = order.OrderID })" 
                                   class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Bạn có chắc chắn muốn hủy đơn hàng #@order.OrderID này? Hàng sẽ được hoàn về kho.');">
                                    <i class="fas fa-times-circle"></i> Hủy đơn
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Phân trang -->
    <div class="mt-4 d-flex justify-content-center">
        @Html.PagedListPager(Model, page => Url.Action("MyOrder", "Order", new { page, status = ViewBag.CurrentStatus, searchTerm = ViewBag.SearchTerm }),
            PagedListRenderOptions.ClassicPlusFirstAndLast)
    </div>
}
