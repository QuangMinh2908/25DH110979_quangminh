@model _25DH110979_quangminh.Models.Order
@{
    ViewBag.Title = "Đặt Hàng Thành Công! - MyStore";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
    string dateStr = string.Format("{0:yyyyMMdd}", Model.OrderDate);
    string formattedOrderCode = string.Format("#MS-{0}-{1:D4}", dateStr, Model.OrderID);
    string customerName = (Model.Customer != null && !string.IsNullOrEmpty(Model.Customer.CustomerName))
        ? Model.Customer.CustomerName
        : (Session["Username"] != null ? Session["Username"].ToString() : "Quý khách");
}

<div class="container py-5">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
            <i class="fas fa-check-circle me-2"></i> Đặt hàng thành công!
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm text-center p-4 p-md-5" style="border-radius: 16px;">
                <div class="card-body">
                    <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle"
                         style="width: 72px; height: 72px; background-color: #198754;">
                        <i class="fas fa-check text-white fa-2x"></i>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">Đặt Hàng Thành Công!</h2>

                    <p class="text-muted mb-3 fs-6">
                        Mã đơn hàng: <strong class="text-primary">@formattedOrderCode</strong>
                    </p>

                    <p class="text-secondary mb-4 px-md-3" style="line-height: 1.6;">
                        Cảm ơn bạn <strong class="text-dark">@customerName</strong> đã đặt hàng tại <strong>MyStore</strong>.
                        Đơn hàng trị giá <strong class="text-danger">@String.Format("{0:N0} ₫", Model.TotalAmount)</strong> đang được chuẩn bị và sẽ giao đến
                        <strong class="text-dark">@Model.ShippingAddress</strong> trong khoảng <strong class="text-dark">2 - 4 ngày làm việc</strong>.
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-3 mt-2">
                        <a href="@Url.Action("MyOrder", "Order", new { searchTerm = Model.OrderID })"
                           class="btn btn-outline-danger rounded-pill px-4 py-2 fw-semibold">
                            <i class="fas fa-receipt me-2"></i>Xem Hóa Đơn Chi Tiết
                        </a>
                        <a href="@Url.Action("Index", "Home")"
                           class="btn btn-danger rounded-pill px-4 py-2 fw-semibold shadow-sm">
                            <i class="fas fa-home me-2"></i>Về Trang Chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>