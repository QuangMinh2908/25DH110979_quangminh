@model _25DH110979_quangminh.Models.ViewModel.ProfileVM
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<div class="row g-4 my-3">
    <div class="col-md-4">
        <div class="card shadow-sm border-0 text-center p-4">
            <div class="card-body">
                <i class="fas fa-user-circle fa-5x text-primary mb-3"></i>
                <h5 class="card-title fw-bold">@Model.FullName</h5>
                <p class="text-muted">Tài khoản: @@Model.Username</p>
                <div class="d-grid gap-2 mt-4">
                    <a href="@Url.Action("ChangePassword","Account")" class="btn btn-outline-warning btn-sm fw-semibold">
                        <i class="fas fa-key me-1"></i> Đổi mật khẩu
                    </a>
                    <a href="@Url.Action("MyOrder","Order")" class="btn btn-outline-primary btn-sm fw-semibold">
                        <i class="fas fa-box me-1"></i> Lịch sử đơn hàng
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold py-3">
                <i class="fas fa-user-pen me-2"></i>Cập nhật thông tin cá nhân
            </div>
            <div class="card-body p-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        @TempData["Success"]
                    </div>
                }
                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Username)
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên đăng nhập:</label>
                        <input type="text" class="form-control bg-light" value="@Model.Username" readonly />
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.FullName, "Họ và tên *", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Phone, "Số điện thoại *", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Address, "Địa chỉ nhận hàng", new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                    </div>

                    <button type="submit" class="btn btn-primary px-4 fw-bold">
                        <i class="fas fa-floppy-disk me-1"></i> Lưu thay đổi
                    </button>
                }
            </div>
        </div>
    </div>
</div>
