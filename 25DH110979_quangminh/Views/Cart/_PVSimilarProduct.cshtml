@model List<_25DH110979_quangminh.Models.Product>

@if (Model != null && Model.Count > 0)
{
    <div class="row row-cols-2 row-cols-md-4 g-2 mt-2">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 p-2">
                    <a href="@Url.Action("ProductDetail","Home", new { id = p.ProductID })" class="text-center p-1 bg-white">
                        <img src="@Url.Content("~/Content/images/" + (string.IsNullOrEmpty(p.ProductImage) ? "default.png" : p.ProductImage))"
                             style="height:110px; width:100%; object-fit:contain;"
                             onerror="this.src='/Content/images/default.png'" alt="@p.ProductName" />
                    </a>
                    <div class="card-body p-2 d-flex flex-column">
                        <small class="fw-semibold text-truncate d-block mb-1" title="@p.ProductName">
                            <a href="@Url.Action("ProductDetail","Home", new { id = p.ProductID })" class="text-dark text-decoration-none">@p.ProductName</a>
                        </small>
                        <small class="text-danger fw-bold mt-auto">@p.ProductPrice.ToString("N0") đ</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
